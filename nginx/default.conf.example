# don't redirect proxy
# proxy_redirect  off;
# turn off global logging
# access_log off;
# logging format
log_format compression '$remote_addr - $remote_user [$time_local] '
                       '"$request" $status $bytes_sent '
                       '"$http_referer" "$http_user_agent" "$gzip_ratio"';
############################
#
# allow let`s Encrypt on port 80 for all domains
#
server {
  listen 80;
  listen [::]:80;
  server_name ~. ;

  location /.well-known/acme-challenge {
    root /var/www/certbot;
    default_type text/plain;
  }

  location / {
    return 301 https://$host$uri;
  }
}

#client
server {
    #listen 80;
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name new.vechorka.ru www.new.vechorka.ru;
    server_tokens off;

  #location /.well-known/acme-challenge {
  #  root /var/www/certbot;
  #  default_type text/plain;
  #}

        ssl_certificate /etc/nginx/ssl/live/new.vechorka.ru-0001/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/live/new.vechorka.ru-0001/privkey.pem;

    client_max_body_size 64M;

    location / {
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_pass http://client:3000;
    }

}

#api
server {
    listen 80;
    server_name api.vechorka.ru www.api.vechorka.ru;
    server_tokens off;
    client_max_body_size 64M;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
      proxy_http_version 1.1;
      proxy_cache_bypass $http_upgrade;

      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_pass http://api:5000;
      }
}


#wp
server {
    listen 80;
    server_name admin.vechorka.ru www.admin.vechorka.ru;

    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    client_max_body_size 64M;
    location / {
      proxy_http_version 1.1;
      proxy_cache_bypass $http_upgrade;

      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;

      proxy_pass http://wp;
    }
}

server {

    listen 80;
    server_name phpmyadmin.vechorka.ru www.phpmyadmin.vechorka.ru;
    client_max_body_size 256M;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
      proxy_http_version 1.1;
      proxy_cache_bypass $http_upgrade;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection 'upgrade';
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_pass http://phpmyadmin;
    }
}
